    function beamMeUp(p_key) {
        $.get("/Player/Teleport", {
            p_key: p_key
        }, function (data) {
            var tlAux = new TimelineMax({ repeat: 0, repeatDelay: 0 });
            if (data.result == true) {
                $("#box_login #key").fadeOut();
                $("#box_login #trg_nowhere").fadeOut();
                tlAux.add(TweenLite.to(eLoginContainer, .34, { background: "rgba(51,170,0, .61)", ease: Linear.easeNone }), 0);
                setTimeout(function () { window.location = data.destiny; }, 500);
            }
            else {
                tlAux.add(TweenLite.to(eLoginContainer, .34, { background: "rgba(153,0,17, .81)", ease: Linear.easeNone }), 0);
                tlAux.add(TweenLite.to(eLoginContainer, .34, { background: "rgba(100,100,100, .81)", ease: Linear.easeNone }), 1.2);
            }
        });
        return false;
    }

