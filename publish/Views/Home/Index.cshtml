    function build_screen(p_page) {
        switch (p_page) {
            case "recover":
                $("#box_login .eReanimation").css("display", "none");
                $("#box_login .eRegister").css("display", "none");
                $("#box_login .eLogin").css("display", "none");
                $("#box_login .eRecover").fadeIn();
                break;

            case "login":
                $("#box_login .eReanimation").css("display", "none");
                $("#box_login .eRegister").css("display", "none");
                $("#box_login .eRecover").css("display", "none");
                $("#box_login .eLogin").fadeIn();
                break;

            case "register":
                $("#box_login .eReanimation").css("display", "none");
                $("#box_login .eLogin").css("display", "none");
                $("#box_login .eRecover").css("display", "none");
                $("#box_login .eRegister").fadeIn();
                break;

            case "reanimation":
                $("#box_login .eRegister").css("display", "none");
                $("#box_login .eLogin").css("display", "none");
                $("#box_login .eRecover").css("display", "none");
                $("#box_login .eReanimation").fadeIn();
                break;

        }
    }
